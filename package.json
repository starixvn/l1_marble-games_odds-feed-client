{
  "name": "odds-feed-client",
  "version": "3.4.2",
  "description": "Event-based odds feed client",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "require": "./lib/index.js",
      "import": "./lib/index.js"
    },
    "./awilix": {
      "require": "./lib/container/awilix/index.js",
      "import": "./lib/container/awilix/index.js",
      "types": "./lib/container/awilix/index.d.ts"
    },
    "./container": {
      "require": "./lib/container/core/index.js",
      "import": "./lib/container/core/index.js",
      "types": "./lib/container/core/index.d.ts"
    },
    "./dependency-injection": {
      "require": "./lib/dependency-injection/index.js",
      "import": "./lib/dependency-injection/index.js",
      "types": "./lib/dependency-injection/index.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "dependency-injection": [
        "lib/dependency-injection/index.d.ts"
      ],
      "awilix": [
        "lib/container/awilix/index.d.ts"
      ],
      "container": [
        "lib/container/core/index.d.ts"
      ],
      ".": [
        "lib/index.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "rimraf lib && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "test": "jest --testPathPatterns=tests/unit-tests/",
    "test:watch": "jest --watch",
    "test-coverage": "jest --collect-coverage --testPathPatterns=tests/unit-tests/",
    "test:ci": "jest --ci --coverage",
    "reg": "npm set registry http://npm.lumigame.com",
    "pub": "npm publish --registry http://npm.lumigame.com",
    "betaver": "npm version prerelease --preid beta",
    "pubbeta": "npm publish --registry http://npm.lumigame.com --tag beta",
    "semantic-release": "semantic-release",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "lint": "npm run format:check"
  },
  "keywords": [
    "odd feed",
    "marble",
    "sdk"
  ],
  "files": [
    "lib/"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.8.0",
    "jest": "30.2.0",
    "jest-junit": "16.0.0",
    "jest-sonar-reporter": "2.0.0",
    "prettier": "3.6.2",
    "rimraf": "6.0.1",
    "sc-semantic-release": "1.3.0",
    "semantic-release": "25.0.0",
    "ts-jest": "29.4.4",
    "ts-node": "10.9.2",
    "tsc-alias": "^1.8.16",
    "typescript": "5.9.3"
  },
  "jestSonar": {
    "reportPath": "reports",
    "reportFile": "test-report.xml",
    "indent": 4
  },
  "dependencies": {
    "@sentry/node": "^10.20.0",
    "awilix": "^12.0.5",
    "cron": "^4.3.3"
  }
}
