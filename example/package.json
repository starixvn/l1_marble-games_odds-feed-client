{
    "name": "marble-odd-feed-data-example",
    "version": "0.0.0",
    "description": "Event-based odd feed data SDK for Marble Products",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "require": "./lib/index.js",
            "import": "./lib/index.js"
        }
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "rimraf lib && tsc",
        "dev": "cross-env NODE_ENV=development tsx watch ./src/index.ts",
        "reg": "npm set registry http://npm.lumigame.com",
        "pub": "npm publish --registry http://npm.lumigame.com",
        "betaver": "npm version prerelease --preid beta",
        "pubbeta": "npm publish --registry http://npm.lumigame.com --tag beta",
        "semantic-release": "semantic-release"
    },
    "keywords": [
        "rng",
        "crypto",
        "secure",
        "random",
        "shuffle"
    ],
    "files": [
        "lib/"
    ],
    "author": "",
    "license": "ISC",
    "devDependencies": {
       "@types/node": "24.6.2",
        "rimraf": "6.0.1",
        "sc-semantic-release": "1.3.0",
        "semantic-release": "24.2.3",
        "typescript": "5.8.2",
        "tsx": "4.20.3"
    },
    "dependencies": {
        "awilix": "^12.0.5",
        "cron": "^4.3.3",
        "odd-feed-client": "1.3.0",
        "cross-env": "^10.0.0"
    }
}
