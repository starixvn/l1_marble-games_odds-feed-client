{
    "name": "marble-odds-feed-data-example",
    "version": "0.0.0",
    "description": "Event-based odd feed data SDK for Marble Products",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "require": "./lib/index.js",
            "import": "./lib/index.js"
        }
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "rimraf lib && tsc",
        "dev": "cross-env NODE_ENV=development tsx watch ./src/index.ts",
        "reg": "npm set registry http://npm.lumigame.com"
    },
    "keywords": [
        "rng",
        "crypto",
        "secure",
        "random",
        "shuffle"
    ],
    "files": [
        "lib/"
    ],
    "author": "",
    "license": "ISC",
    "devDependencies": {
       "@types/node": "24.6.2",
        "rimraf": "6.0.1",
        "typescript": "5.9.3",
        "tsx": "4.20.6"
    },
    "dependencies": {
        "awilix": "^12.0.5",
        "cron": "^4.3.3",
        "odds-feed-client": "1.3.0",
        "cross-env": "^10.0.0"
    }
}
